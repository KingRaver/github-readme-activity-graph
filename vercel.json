{
    "version": 2,
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/stats",
            "dest": "https://github-readme-stats-psi-lyart.vercel.app/api"
        },
        {
            "src": "/top-langs",
            "dest": "https://github-readme-stats-psi-lyart.vercel.app/api/top-langs"
        },
        {
            "src": "/substack-feed",
            "dest": "https://jeffspirlock.substack.com/feed"
        },
        {
            "src": "/(.*)",
            "dest": "src/main.ts"
        }
    ]
}
